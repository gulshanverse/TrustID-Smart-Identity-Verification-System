APP_ENV=development
DATABASE_URL=postgresql+psycopg://trustid:trustid@localhost:5432/trustid
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=trustid-documents
OBJECT_STORAGE_ACCESS_KEY=replace-with-local-or-cloud-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-local-or-cloud-secret-key
OCR_PROVIDER=demo
# Use OCR_PROVIDER=production only when local Tesseract and Python OCR dependencies are installed.
TAMPERING_PROVIDER=demo
FACE_PROVIDER=demo
ANALYSIS_PROCESSING_TIMEOUT_SECONDS=1800
FACE_MODEL_PATH=models/face_recognition_sface_2021dec.onnx
FACE_MODEL_SHA256=
FACE_DETECTOR=haar
FACE_DETECTOR_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_DETECTOR_MODEL_SHA256=
FACE_DETECTOR_SCORE_THRESHOLD=0.9
# Phase 2.4 quality controls; local application defaults preserve the existing gate.
# The production candidate Docker image explicitly overrides these to YuNet + blur 5.0.
FACE_BOX_PADDING=0.0
FACE_MIN_FACE_PIXELS=6400
FACE_BLUR_THRESHOLD=20.0
FACE_BRIGHTNESS_MIN=35.0
FACE_BRIGHTNESS_MAX=225.0
FACE_CONTRAST_MIN=18.0
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
DEMO_PASSWORD=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE=28800
